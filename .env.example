# Copy this file to .env and fill in the values.

ADMIN_USER=admin
# Password for the admin panel. Use something long.
ADMIN_PASSWORD=change-me
# Random string used to sign login cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-too

# Optional
# SESSION_HOURS=24
# MAX_UPLOAD_MB=4096
# COOKIE_SECURE=true     # when the site is served over HTTPS
# TRUST_PROXY=true       # when running behind nginx/Caddy/Traefik
